# Assinatura de RELEASE do Android — TEMPLATE (este .example É versionado).
#
# Copie este arquivo para android/keystore.properties (que NÃO é versionado) e
# preencha os 4 valores abaixo. A keystore (.jks) mora FORA do repo (ex.: ~/keys/)
# e nunca deve ser commitada.
#
#   cp android/keystore.properties.example android/keystore.properties

# Caminho ABSOLUTO para a keystore de upload (.jks). Ex.: /Users/voce/keys/toorganizado-upload.jks
storeFile=

# Senha da keystore (store password)
storePassword=

# Alias da chave dentro da keystore. Ex.: toorganizado-upload
keyAlias=

# Senha da chave (key password) — costuma ser igual à da store
keyPassword
