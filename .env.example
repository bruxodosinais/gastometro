# Chaves PÚBLICAS de SDK do RevenueCat (IAP nativo). Podem ir no client (prefixo
# NEXT_PUBLIC_). São inlined no bundle em build time e escolhidas por plataforma
# em lib/revenuecat.ts. Se vazias, initRevenueCat() só loga um aviso e segue —
# o boot nativo não trava. // Fase 1 preenche com os valores reais do console.
NEXT_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret do webhook RevenueCat (SÓ servidor — NÃO usa prefixo NEXT_PUBLIC_). O
# painel RevenueCat manda esse valor EXATO no header Authorization; o webhook
# compara byte-a-byte. Vai na Vercel (não no client). // Fase 1 preenche.
# ⚠️ URL do webhook no painel TEM que ser https://www.toorganizado.com.br/... (WWW).
RC_WEBHOOK_TOKEN=troque-por-um-secret-forte

# Link da App Store (preencher quando o app for aprovado; vazio = botão "Em breve")
NEXT_PUBLIC_APP_STORE_URL=
